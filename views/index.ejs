<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ambifo Technology - Digital Innovation Solutions</title>
  <link rel="icon" type="image/png" href="/images/ambifologo.png">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar">
    <div class="nav-container">
      <div class="nav-brand">
        <a href="/" class="logo-link">
          <img src="/images/ambifologo.png" alt="Ambifo Logo" class="logo">
        </a>
        <span class="brand-name">Ambifo</span>
      </div>
      <ul class="nav-menu">
        <li><a href="/" class="nav-link active">Home</a></li>
        <li class="dropdown">
          <a href="/services" class="nav-link">Solutions</a>
          <div class="dropdown-menu">
            <a href="/services#cloud-migration" class="dropdown-item">Cloud Migration Services</a>
            <a href="/services#devops" class="dropdown-item">Cloud DevOps & Automation</a>
            <a href="/services#finops" class="dropdown-item">Cloud FinOps & Optimization</a>
            <a href="/services#security" class="dropdown-item">Cloud Security & Compliance</a>
            <a href="/services#managed" class="dropdown-item">Managed Cloud Services</a>
            <a href="/services#aiml" class="dropdown-item">AI/ML & Modern Applications</a>
          </div>
        </li>
        <li><a href="/services" class="nav-link">Services</a></li>
        <li class="dropdown">
          <a href="#" class="nav-link">Resources</a>
          <div class="dropdown-menu">
            <a href="/blog" class="dropdown-item">Blog</a>
            <a href="/portfolio" class="dropdown-item">Case Studies</a>
            <a href="/documentation" class="dropdown-item">Documentation</a>
          </div>
        </li>
        <li><a href="/about" class="nav-link">About</a></li>
        <li><a href="/contact" class="nav-link cta-btn">Contact Us</a></li>
      </ul>
      <div class="hamburger">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero">
    <div id="canvas-container" class="hero-canvas-3d"></div>
    <div class="hero-content">
      <h1>Cloud Transformation at Scale</h1>
      <p>Enterprise-grade cloud solutions for AWS, Azure, and GCP with AI-driven optimization</p>
      <button class="btn btn-primary" onclick="showConsultationModal()">Schedule Free Consultation</button>
    </div>
    <canvas id="ambifoCanvas" class="hero-canvas"></canvas>
    <div class="hero-background"></div>
  </section>

  <!-- Features Section -->
  <section class="features">
    <div class="container">
      <h2>Why Organizations Choose Ambifo</h2>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <i class="fas fa-chart-line"></i>
          </div>
          <h3>Proven Expertise</h3>
          <p>AWS & multi-cloud certified with 500+ successful projects and 150+ happy enterprise clients</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <i class="fas fa-shield-alt"></i>
          </div>
          <h3>Security & Compliance</h3>
          <p>ISO 27001, GDPR, HIPAA, HIPAA-compliant solutions with enterprise-grade security</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <i class="fas fa-clock"></i>
          </div>
          <h3>24/7 Support & Optimization</h3>
          <p>Round-the-clock monitoring, optimization, and dedicated support teams</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <i class="fas fa-bolt"></i>
          </div>
          <h3>Faster Deployment</h3>
          <p>90% faster provisioning and 40%+ cost savings through intelligent automation</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta">
    <div class="cta-content">
      <h2>Accelerate Your Cloud Transformation Today</h2>
      <p>Get expert guidance from cloud architects and DevOps specialists</p>
      <button class="btn btn-secondary" onclick="window.location.href='/contact'">Get Free Cloud Assessment</button>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-content">
      <div class="footer-section">
        <h4>Ambifo Technology</h4>
        <p>Delivering innovative digital solutions worldwide</p>
      </div>
      <div class="footer-section">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about">About Us</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/contact">Contact Us</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>Legal</h4>
        <ul>
          <li><a href="/privacy-policy">Privacy Policy</a></li>
          <li><a href="/terms">Terms & Conditions</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2024 Ambifo Technology Pvt Ltd. All rights reserved.</p>
    </div>
  </footer>

  <!-- Consultation Popup Modal -->
  <div id="consultationModal" class="consultation-modal">
    <div class="consultation-modal-content">
      <button class="close-modal" onclick="closeConsultationModal()">&times;</button>
      <div class="modal-header">
        <h2>Get Free Cloud Consultation</h2>
        <p>Schedule a 30-minute consultation with our cloud experts</p>
      </div>
      <form id="consultationForm" class="consultation-form" onsubmit="handleConsultationSubmit(event)">
        <!-- Row 1: Service & Company -->
        <div class="form-group">
          <label for="service">Service *</label>
          <select id="service" name="service" required>
            <option value="">Select service</option>
            <option value="Cloud Migration">Cloud Migration</option>
            <option value="DevOps">DevOps</option>
            <option value="FinOps">FinOps</option>
            <option value="Security">Security</option>
            <option value="Managed">Managed Services</option>
            <option value="AI/ML">AI/ML</option>
          </select>
        </div>
        <div class="form-group">
          <label for="company">Company</label>
          <input type="text" id="company" name="company" placeholder="Your Company">
        </div>
        <!-- Row 2: Full Name & Phone -->
        <div class="form-group">
          <label for="fullName">Full Name *</label>
          <input type="text" id="fullName" name="fullName" required placeholder="Full Name">
        </div>
        <div class="form-group">
          <label for="phone">Phone *</label>
          <input type="tel" id="phone" name="phone" required placeholder="Phone">
        </div>
        <!-- Row 3: Email -->
        <div class="form-group form-full-width">
          <label for="email">Email *</label>
          <input type="email" id="email" name="email" required placeholder="Email">
        </div>
        <!-- Row 4: Button -->
        <button type="submit" class="btn-submit btn-submit-full">Schedule Consultation</button>
      </form>
      <div id="successMessage" class="success-message" style="display: none;">
        <i class="fas fa-check-circle"></i>
        <p>Thank you! We'll contact you shortly to confirm your consultation.</p>
      </div>
    </div>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>
