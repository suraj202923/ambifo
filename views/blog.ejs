  <!-- Newsletter Section -->
  <section class="newsletter-section">
    <div class="container">
      <h2>Subscribe to Our Newsletter</h2>
      <p>Get the latest insights and updates delivered to your inbox</p>
      <form class="newsletter-form">
        <input type="email" placeholder="Your email address" required>
        <button type="submit" class="btn btn-primary">Subscribe</button>
      </form>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-content">
      <div class="footer-section">
        <h4>Ambifo Technology Pvt Ltd</h4>
        <p><i class="fas fa-map-marker-alt"></i> Building No 674, 18th Main, 3rd Phase, Front of New Land ISRO Quarter, Domlur, Bangalore - 560071</p>
        <p><i class="fas fa-phone"></i> +91 9148419502</p>
        <p><i class="fas fa-envelope"></i> our contact form</p>
      </div>
      <div class="footer-section">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/services">Services</a></li>
