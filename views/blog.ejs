  <!-- Hero Section with Banner -->
  <section class="hero">
    <div id="canvas-container" class="hero-canvas-3d"></div>
    <div class="hero-content">
      <h1>Our Blog</h1>
      <p>Latest Insights and Industry Trends</p>
    </div>
    <canvas id="ambifoCanvas" class="hero-canvas"></canvas>
    <div class="hero-background"></div>
  </section>

  <!-- Blog Grid -->
  <section class="blog-section">
    <div class="container">
      <div class="blog-grid">
        <article class="blog-card">
          <div class="blog-image" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"></div>
          <div class="blog-content">
            <div class="blog-meta">
              <span class="blog-date">April 14, 2024</span>
              <span class="blog-category">Technology</span>
            </div>
