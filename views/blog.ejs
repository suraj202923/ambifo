      <div class="footer-section">
        <h4>Services</h4>
        <ul>
          <li><a href="/cloud-migration">Cloud Migration</a></li>
          <li><a href="/cloud-devops">DevOps & Automation</a></li>
          <li><a href="/cloud-finops">FinOps</a></li>
          <li><a href="/cloud-security">Security & Compliance</a></li>
        </ul>
      </div>
      <div class="footer-section">
